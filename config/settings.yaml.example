# Budget Analyzer Configuration
# ==============================
# Copy this file to settings.yaml and customize for your data.

# Time period for analysis
year: 2025
title: "Spending Analysis"

# Currency display format (default: "${amount}")
# Use {amount} as placeholder for the formatted number
# currency_format: "${amount}"      # US Dollar (prefix)
# currency_format: "{amount} zł"    # Polish Złoty (suffix)
# currency_format: "€{amount}"      # Euro (prefix)
# currency_format: "£{amount}"      # British Pound (prefix)

# Data sources - list of transaction files to process
# Paths are relative to the parent of the config directory
data_sources:
  - name: AMEX
    file: data/amex-2025.csv
    type: amex
  - name: BOA
    file: data/boa-checking.txt
    type: boa
  # Folder + glob examples (CSV only):
  # - name: Exports (top-level only)
  #   file: data/exports/          # loads all *.csv in this folder
  # - name: Monthly Exports
  #   file: data/exports/*.csv     # top-level glob
  # - name: All Exports (recursive)
  #   file: data/exports/**/*.csv  # recursive glob
  # European format example (semicolon-delimited with comma decimals):
  # - name: European Bank
  #   file: data/export.csv
  #   format: "{date:%d-%m-%Y},{description},{amount}"
  #   delimiter: ";"           # Semicolon-separated columns
  #   decimal: ","             # 1.234,56 format (comma = decimal, period = thousands)

  # Multi-column description example:
  # Some banks split transaction info across columns (e.g., type + recipient).
  # Use custom captures to combine them:
  # - name: European Bank
  #   file: data/bank.csv
  #   format: "{date:%d.%m.%Y},{_},{txn_type},{vendor},{_},{amount}"
  #   columns:
  #     description: "{vendor} ({txn_type})"  # Combines columns into description
  #
  # Optional fee column (added to amount):
  # - name: Checking
  #   file: data/checking.csv
  #   format: "{date:%m/%d/%Y},{description},{amount},{fee}"

# Output settings
output_dir: output
html_filename: spending_summary.html

# Beancount export settings (for --format beancount)
# Maps tally categories to beancount accounts
# CLI note: --format beancount now requires --beancount-output <folder>, and writes YYYY/MM.bean + MM-manual.bean.
# beancount:
#   currency: "USD"                              # Override currency (default: extracted from currency_format)
#   default_expense_account: "Expenses:FIXME"    # Used when category unknown
#   default_asset_account: "Assets:FIXME"        # Used when source not mapped
#
#   # Map data sources to asset/liability accounts
#   source_accounts:
#     AMEX: "Liabilities:CreditCard:Amex"
#     Chase: "Liabilities:CreditCard:Chase"
#     Checking: "Assets:Bank:Checking"
#
#   # Map categories to expense accounts
#   account_mappings:
#     # Simple category -> account mapping
#     Subscriptions: "Expenses:Subscriptions"
#
#     # Category with subcategory mappings
#     Food:
#       Grocery: "Expenses:Food:Groceries"
#       Restaurant: "Expenses:Food:DiningOut"
#       _default: "Expenses:Food:Other"
#
#     # Special accounts for tagged transactions
#     _income: "Income:Salary"
#     _transfer: "Assets:Transfer"
#     _investment: "Assets:Investments:Retirement"
